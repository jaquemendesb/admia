# ─────────────────────────────────────────────────────────────────────────────
# ADMIA — Environment Variables
#
# Copy this file to .env.local for local development.
# In production (Docker Swarm), inject via environment or secrets.
#
# Generate secrets with:
#   openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Docker Swarm: postgres resolves to the PostgreSQL service on pjm-network
# Desenvolvimento local: usar dados.jaquemendes.com:5432
# Produção (Docker Swarm): postgres:5432 (resolução interna da rede)
DATABASE_URL=postgresql://postgres:PASSWORD@dados.jaquemendes.com:5432/pjm_automation_ai

# ── Auth.js / NextAuth ────────────────────────────────────────────────────────
NEXTAUTH_URL=https://admia.jaquemendes.com
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-generated-secret

# ── Credential Encryption ────────────────────────────────────────────────────
# Used to encrypt integration credentials at rest (AES-256-GCM)
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-generated-secret

# ── Runtime API Key ──────────────────────────────────────────────────────────
# Used by n8n and other runtime services to authenticate against ADMIA runtime endpoints
# n8n must send: Authorization: Bearer <RUNTIME_API_KEY>
# Generate: openssl rand -base64 32
RUNTIME_API_KEY=replace-with-generated-secret

# ── Redis ────────────────────────────────────────────────────────────────────
# Docker Swarm: redis resolves to the Redis service on pjm-network
# Formato: redis://:PASSWORD@host:port  (sem senha: redis://host:port)
REDIS_URL=redis://n8n_redis:6379

# ── n8n Cache Refresh Webhook ────────────────────────────────────────────────
# URL do webhook no n8n que atualiza o Redis ao salvar persona/agents
# Criado pelo workflow "ADMIA Cache Refresh" no n8n
N8N_CACHE_WEBHOOK_URL=https://automacao.jaquemendes.com/webhook/admia-cache-refresh
# Segredo compartilhado para validar a chamada no n8n (opcional mas recomendado)
# Generate: openssl rand -base64 32
N8N_CACHE_WEBHOOK_SECRET=replace-with-generated-secret

# ── Seed (development / first deploy only) ───────────────────────────────────
SEED_ADMIN_EMAIL=admin@admia.local
SEED_ADMIN_PASSWORD=replace-with-strong-password
